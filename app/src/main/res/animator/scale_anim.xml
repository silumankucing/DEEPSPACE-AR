<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator android:propertyName="scaleX" android:duration="80" android:valueTo="0.88" android:valueType="floatType"/>
        <objectAnimator android:propertyName="scaleY" android:duration="80" android:valueTo="0.88" android:valueType="floatType"/>
        <objectAnimator android:propertyName="alpha" android:duration="80" android:valueTo="0.75" android:valueType="floatType"/>
    </item>
    <item>
        <objectAnimator android:propertyName="scaleX" android:duration="120" android:valueTo="1.0" android:valueType="floatType"/>
        <objectAnimator android:propertyName="scaleY" android:duration="120" android:valueTo="1.0" android:valueType="floatType"/>
        <objectAnimator android:propertyName="alpha" android:duration="120" android:valueTo="1.0" android:valueType="floatType"/>
    </item>
</selector>

