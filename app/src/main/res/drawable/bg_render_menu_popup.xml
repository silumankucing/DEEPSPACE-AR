<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Warna mengikuti theme aktif (day: putih, night: dark_surface) supaya latar popup
         selalu sama dengan mode yang dipilih pada toggle Setting, tidak bergantung
         kualifikasi `values-night` yang bisa tertinggal dari toggle. -->
    <solid android:color="?attr/colorSurface" />
    <corners android:radius="8dp" />
</shape>
