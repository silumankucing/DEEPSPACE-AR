<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Style OUTLINE untuk input pencarian Explore: tanpa isian (transparan) sehingga
         menyatu dengan latar halaman, hanya dibatasi garis tepi biru. -->
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1.5dp"
        android:color="@color/blue_dark_secondary" />
    <corners android:radius="6dp" />
</shape>
