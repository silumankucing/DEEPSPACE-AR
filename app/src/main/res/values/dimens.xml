<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ukuran NavigationView item agar fit tanpa scroll -->
    <dimen name="design_navigation_icon_size">16dp</dimen>
    <dimen name="design_navigation_item_icon_padding">4dp</dimen>
    <!-- Default wajib ada di base folder agar values-land tidak dianggap
         resource tanpa fallback (lint: MissingDefaultResource). -->
    <dimen name="design_navigation_item_padding">0dp</dimen>
    <!-- Padding top untuk TabLayout di Project & Explore agar tidak overlap kamera -->
    <dimen name="tab_layout_top_padding">30dp</dimen>
    <!-- Tinggi seragam SEMUA baris item halaman Setting (activity_settings.xml):
         Dark Mode, Language, Orientation Mode, Learning, Share Apps, Feedback,
         Report Bug, Privacy Policy, dan About memakai nilai ini sebagai `minHeight`.
         Nilai 56dp membuat baris Language ikut seragam (sebelumnya 64dp sehingga
         tampak lebih tinggi daripada item lain):
           - baris switch  : switch Material 48dp + padding vertikal 2 x 4dp,
           - baris spinner : spinner 24dp + padding vertikal 2 x 8dp,
           - baris teks    : teks 18sp (tinggi ± 23,3dp) + padding 2 x 16dp.
         Dipakai sebagai `minHeight` (bukan tinggi tetap) supaya baris tetap sama
         tinggi pada font normal dan masih bisa tumbuh bila ukuran font sistem
         diperbesar (aksesibilitas). -->
    <dimen name="settings_row_height">56dp</dimen>
</resources>

