<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded_white"
    android:padding="8dp">

    <!-- Rename -->
    <LinearLayout
        android:id="@+id/btnMenuRename"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_menu_button_grey"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_rename"
            android:contentDescription="Rename" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rename"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/jaturat" />

    </LinearLayout>

    <!-- Delete -->
    <LinearLayout
        android:id="@+id/btnMenuDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_menu_button_grey"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_delete"
            android:contentDescription="Delete" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/jaturat" />

    </LinearLayout>

</LinearLayout>
