<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <!-- Camera preview sebagai background AR.
             PreviewView (CameraX) mengatur sendiri ukuran buffer, rotasi dan
             aspek preview (fill-center crop), jadi frame kamera tetap tegak dan
             memenuhi layar baik pada portrait maupun landscape. -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <!-- SurfaceView transparan untuk overlay model 3D Filament -->
        <android.view.SurfaceView
            android:id="@+id/filamentSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Project Name (kiri atas) -->
        <TextView
            android:id="@+id/txtProjectName"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_project_name"
            android:fontFamily="@font/jaturat"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="AR Scene"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Tree Panel (di bawah txtProjectName) -->
        <FrameLayout
            android:id="@+id/treePanel"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnDocument"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProjectName">
            <ScrollView
                android:id="@+id/scrollTreeView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="vertical">
                <LinearLayout
                    android:id="@+id/treeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </FrameLayout>

        <!-- Document Button (bottom left) -->
        <android.widget.ImageButton
            android:id="@+id/btnDocument"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:contentDescription="Document"
            android:background="@drawable/bg_menu_button"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/icon_document"
            android:stateListAnimator="@animator/scale_anim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Menu Button (bottom right) -->
        <android.widget.ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_menu_button"
            android:contentDescription="Menu"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_grid_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

