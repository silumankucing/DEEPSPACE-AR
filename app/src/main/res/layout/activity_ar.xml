<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <!-- Camera preview sebagai background AR.
             PreviewView (CameraX) mengatur sendiri ukuran buffer, rotasi dan
             aspek preview (fill-center crop), jadi frame kamera tetap tegak dan
             memenuhi layar baik pada portrait maupun landscape. -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <!-- SurfaceView transparan untuk overlay model 3D Filament -->
        <android.view.SurfaceView
            android:id="@+id/filamentSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Project Name (kiri atas) -->
        <TextView
            android:id="@+id/txtProjectName"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_project_name"
            android:fontFamily="@font/jaturat"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="AR Scene"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Tree Panel (di bawah txtProjectName) -->
        <FrameLayout
            android:id="@+id/treePanel"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:elevation="5dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnDocument"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtProjectName">
            <ScrollView
                android:id="@+id/scrollTreeView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="vertical">
                <LinearLayout
                    android:id="@+id/treeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </FrameLayout>

        <!-- Document Button (bottom left) -->
        <android.widget.ImageButton
            android:id="@+id/btnDocument"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:contentDescription="Document"
            android:background="@drawable/bg_menu_button"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/icon_document"
            android:stateListAnimator="@animator/scale_anim"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Menu Button (bottom right) -->
        <android.widget.ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_menu_button"
            android:contentDescription="Menu"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_grid_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Panel Lighting (pengganti popup Lighting): SATU slider (untuk parameter yang sedang
             dipilih) yang disejajarkan HORISONTAL dalam satu baris dengan tombol lingkaran biru
             bertulisan putih x / y / z (sumbu pergeseran cahaya) dan b (tingkat brightness).
             Tombol aktif ditandai warna orange; nilai sumbu aktif tampil di txtLightingValue.
             Panel dibuka/ditutup dari item Lighting pada menu AR dan diletakkan serendah mungkin
             (di atas tombol Document/Menu 48dp + margin 16dp) agar keduanya tetap bisa ditekan.
             Lebar panel maksimal 520dp dan di-center, jadi slider yang menyesuaikan lebar. -->
        <LinearLayout
            android:id="@+id/lightingPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="68dp"
            android:background="@drawable/bg_render_menu_popup"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="520dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jaturat"
                    android:text="Lighting"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtLightingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jaturat"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Satu baris horizontal: slider mengisi sisa lebar (weight 1) dan tombol x/y/z/b
                 rapat ke kanan, sehingga slider & keempat tombol selalu sejajar horisontal. -->
            <LinearLayout
                android:id="@+id/lightingAxisRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/lightingSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="120dp"
                    android:max="100" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLightAxisX"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:text="x"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="#3D93C8"
                    app:cornerRadius="20dp"
                    app:rippleColor="#80FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLightAxisY"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:text="y"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="#3D93C8"
                    app:cornerRadius="20dp"
                    app:rippleColor="#80FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLightAxisZ"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:text="z"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="#3D93C8"
                    app:cornerRadius="20dp"
                    app:rippleColor="#80FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLightAxisB"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:text="b"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:backgroundTint="#3D93C8"
                    app:cornerRadius="20dp"
                    app:rippleColor="#80FFFFFF" />
            </LinearLayout>
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

