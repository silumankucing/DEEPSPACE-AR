<?xml version="1.0" encoding="utf-8"?>
<!-- Isi popup About (pengganti halaman About lama activity_settings_about.xml).
     Dua baris: nama aplikasi + versi (`DEEPSPACE AR v0.8.0`) lalu status rilis
     (`(Early Access)`), ditutup tombol OK. Sudut popup tajam mengikuti
     bg_dialog_sharp.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingVertical="24dp">

    <TextView
        android:id="@+id/txtAboutAppVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jaturat"
        android:gravity="center"
        android:text="@string/about_app_version"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtAboutEarlyAccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/jaturat"
        android:gravity="center"
        android:text="@string/about_early_access"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp" />

    <!-- Tombol OK. Lebarnya PROPORSIONAL terhadap lebar isi popup (50% dari lebar
         isi, dihitung dengan `weightSum` seperti pola di activity_settings.xml),
         jadi ikut menyesuaikan bila lebar popup diubah — bukan dp tetap. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnAboutOk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:background="@drawable/bg_about_ok_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jaturat"
            android:gravity="center"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
