<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingTop="48dp"
    android:background="?android:attr/colorBackground">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jaturat"
            android:gravity="center"
            android:text="DEEPSPACE"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jaturat"
            android:gravity="center"
            android:text="(Early Access)"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Blue divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#3D93C8"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp" />

    <!-- Support Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/jaturat"
        android:gravity="center"
                android:text="Support the developer with a cup of coffee"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- Yearly Plan (save 55%) -->
    <LinearLayout
        android:id="@+id/btnYearlyPlan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_premium_plan_selected"
        android:stateListAnimator="@null"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jaturat"
                        android:text="Annual"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jaturat"
            android:text="save 45%"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#C8E6C9"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp"
            android:includeFontPadding="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jaturat"
                        android:text="Rp. 98.000"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/imgYearlyPlanCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/presence_online"
            android:scaleType="fitCenter"
            app:tint="#3D93C8" />

    </LinearLayout>

    <!-- Monthly Support Plan -->
    <LinearLayout
        android:id="@+id/btnMonthlyPlan"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_premium_plan_selected"
        android:stateListAnimator="@null"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jaturat"
                        android:text="Monthly"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jaturat"
                        android:text="Rp. 15.000"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/imgMonthlyPlanCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/presence_online"
            android:scaleType="fitCenter"
            app:tint="#3D93C8" />

    </LinearLayout>

    <!-- Blue divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#3D93C8"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="16dp" />

    <!-- Features -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_blue_dot"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jaturat"
                android:text="No Ads"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_blue_dot"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jaturat"
                android:text="Complete Export"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_blue_dot"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jaturat"
                android:text="Complete Import"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_blue_dot"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jaturat"
                android:text="Unlimited Undo &amp; Redo"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_blue_dot"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jaturat"
                android:text="No Watermark"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/bg_blue_dot"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jaturat"
                android:text="Auto-Save"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Upgrade Button seperti tombol Untitled -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnUpgradeNow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_project_name"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jaturat"
            android:text="UPGRADE"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>