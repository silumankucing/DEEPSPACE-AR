<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night theme - true dark grey mode -->
    <style name="Theme.Deepspace" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/blue_dark_primary</item>
        <item name="colorPrimaryVariant">@color/dark_blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue_dark_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_blue_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 🌙 Dark grey surfaces -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorOnBackground">@color/dark_on_background</item>
        <item name="android:colorForeground">@color/dark_on_surface</item>
        <item name="android:textColorPrimary">@color/dark_on_surface</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:fontFamily">@font/jaturat</item>
        <item name="fontFamily">@font/jaturat</item>
        <item name="materialButtonStyle">@style/Widget.Deepspace.MaterialButton</item>
        <item name="navigationViewStyle">@style/Widget.Deepspace.NavigationView</item>
        <item name="android:textViewStyle">@style/Widget.Deepspace.TextViewDark</item>
        <item name="android:buttonStyle">@style/Widget.Deepspace.Button</item>
        <!-- Status bar: transparent, icon terang (tidak dark) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <style name="ThemeOverlay.Deepspace.PopupMenu" parent="ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/Widget.Deepspace.PopupMenuDark</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Deepspace.PopupMenuDark</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Deepspace.PopupMenuDark</item>
    </style>

    <style name="Widget.Deepspace.PopupMenuDark" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/dark_surface</item>
    </style>

    <style name="Widget.Deepspace.TextViewDark" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/jaturat</item>
        <item name="fontFamily">@font/jaturat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>

    <style name="TextAppearance.Deepspace.PopupMenuDark" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/dark_on_surface</item>
        <item name="android:fontFamily">@font/jaturat</item>
        <item name="fontFamily">@font/jaturat</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Deepspace.Tab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/jaturat</item>
        <item name="fontFamily">@font/jaturat</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/dark_on_surface</item>
    </style>
</resources>

